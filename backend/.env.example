# ============================================================
# Intelli-Credit + MiroFish Unified Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual API keys.

# --- Gemini API (PDF parsing, CAM narrative generation) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Groq API (fast OSINT research synthesis) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Tavily API (web research / OSINT queries) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Multi-Agent Simulation LLM (any OpenAI-compatible endpoint) ---
# Used by CAMEL-AI for the swarm simulation engine.
# Can point to Groq, Together AI, OpenRouter, or OpenAI directly.
LLM_API_KEY=your_simulation_llm_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.3-70b-versatile

# --- Neo4j Graph Database (Mem0 temporal memory backend) ---
# Used for localized agent memory storage (banking compliance).
# Docker Compose spins up a local Neo4j instance on these defaults.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=intelli_credit_neo4j

# --- External FinTech Data APIs (optional) ---
SIGNZY_API_KEY=your_signzy_api_key_here
KARZA_API_KEY=your_karza_api_key_here
CIBIL_API_KEY=your_cibil_api_key_here

# --- Databricks (optional — if using lakehouse) ---
# DATABRICKS_SERVER_HOSTNAME=...
# DATABRICKS_HTTP_PATH=...
# DATABRICKS_ACCESS_TOKEN=...

# --- PostgreSQL (application database) ---
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/intelli_credit
